# --- CORE API WRAPPER & HELPER FUNCTIONS ---
function Clean-Input {
    param([string]$Text)
    if ([string]::IsNullOrWhiteSpace($Text)) { return "" }
    $Text = $Text.Trim()
    if ($Text -match '^"(.*)"$') { $Text = $Matches[1] }
    elseif ($Text -match "^'(.*)'$") { $Text = $Matches[1] }
    return $Text.Trim()
}

# WAF BYPASS: Sanitizes payloads to prevent GenAI.mil API block
function Defang-Payload {
    param([string]$Text)
    if ([string]::IsNullOrWhiteSpace($Text)) { return "" }
    $Text = $Text.Replace("http","hxxp").Replace("HTTP","HXXP")
    $Text = $Text.Replace("ftp","fxp").Replace("FTP","FXP")
    $Text = $Text.Replace("://","[:]//")
    $Text = $Text.Replace("rm -rf","r_m -r_f").Replace("rm-rf","r_m-r_f")
    $Text = $Text.Replace("wget","w_get").Replace("curl","c_url")
    $Text = $Text.Replace(".exe","[.]exe").Replace(".sh","[.]sh").Replace(".bin","[.]bin")
    return $Text
}

# ADDED TIMEOUTSEC PARAMETER TO DYNAMICALLY ALLOW AI MORE TIME FOR HUGE JSONS
function Invoke-SafeRest {
    param($Uri, $Headers, $Method = 'Get', $Body, $ShowError = $false, $TimeoutSec = 25)
    try {
        # Using a generic PowerShell UA to prevent Cloudflare/WAF blocks
        $SafeAgent = "PowerShell/CTI-CoPilot"
        $params = @{ Uri = $Uri; Method = $Method; TimeoutSec = $TimeoutSec; UserAgent = $SafeAgent }
        if ($Headers) { $params.Headers = $Headers }
        if ($Body) { $params.Body = $Body }
        return Invoke-RestMethod @params
    } catch {
        if ($ShowError) { Write-Host "`n[!] API Connection Error: $($_.Exception.Message)" -ForegroundColor Yellow }
        return $null
    }
}

# v10.0.1: Private-first URLScan submission with automatic public fallback.
function Invoke-UrlScanSubmission {
    param(
        [string]$Url
    )

    $Result = @{
        Response = $null
        Visibility = $UrlScanPreferredVisibility
        UsedPublicFallback = $false
    }

    if ([string]::IsNullOrWhiteSpace($Url)) {
        return $Result
    }

    $Headers = @{
        'API-Key' = $UrlScan_Key
        'Content-Type' = 'application/json'
    }

    $PrimaryBody = @{
        url = $Url
        visibility = $UrlScanPreferredVisibility
    } | ConvertTo-Json -Compress

    $Submission = Invoke-SafeRest `
        -Uri "https://urlscan.io/api/v1/scan/" `
        -Method Post `
        -Headers $Headers `
        -Body $PrimaryBody

    if ($Submission) {
        $Result.Response = $Submission

        if ($Submission.visibility) {
            $Result.Visibility = [string]$Submission.visibility
        }

        return $Result
    }

    if ($UrlScanPreferredVisibility -eq "private") {
        Write-Host "[!] urlscan private submission failed; retrying with public visibility." -ForegroundColor Yellow

        $PublicBody = @{
            url = $Url
            visibility = "public"
        } | ConvertTo-Json -Compress

        $Submission = Invoke-SafeRest `
            -Uri "https://urlscan.io/api/v1/scan/" `
            -Method Post `
            -Headers $Headers `
            -Body $PublicBody

        if ($Submission) {
            $Result.Response = $Submission
            $Result.Visibility = "public"
            $Result.UsedPublicFallback = $true
        }
    }

    return $Result
}

function Get-BdeInfo {
    param([string]$SearchLocation)
    $Result = @{ Location = $SearchLocation; BDE = "(Check manual list)"; MACOM = "(Check manual list)" }
    if ([string]::IsNullOrWhiteSpace($SearchLocation) -or $SearchLocation -eq "N/A") {
        $Result.Location = "(Check https://www.nic.mil/cgi-bin/whoisweb)"
        return $Result
    }
    foreach ($Row in $Global:BdeMasterList) {
        if ($Row.Location -match [regex]::Escape($SearchLocation) -or $SearchLocation -match [regex]::Escape($Row.Location)) {
            $Result.Location = $Row.Location
            $Result.BDE = $Row.BDE
            $Result.MACOM = $Row.MACOM
            break
        }
    }
    return $Result
}

function Get-NsLookup {
    param($Target)
    if ([string]::IsNullOrWhiteSpace($Target) -or $Target -eq "N/A") { return "N/A" }

    $NsRaw = cmd.exe /c "nslookup $Target 2>&1" | Out-String
    if ($NsRaw -match "Non-existent domain|can't find|NXDOMAIN|\*\*\*") {
        return "Non-existent domain"
    } elseif ([string]::IsNullOrWhiteSpace($NsRaw)) {
        return "Non-existent domain"
    } elseif ($NsRaw -match "(?im)^Name:\s+(.+)") {
        return $Matches[1].Trim()
    } else {
        return $NsRaw.Trim()
    }
}
function Test-IsWhitelisted {
    param([string]$Indicator)
    if ([string]::IsNullOrWhiteSpace($Indicator)) { return $false }

    $Domains = @(".dc.trouter.io")
    foreach ($d in $Domains) {
        if ($Indicator -like "*$d*") { return $true }
    }

    if ($Indicator -match "^(\d{1,3}\.){3}\d{1,3}$") {
        $ipOctets = $Indicator.Split('.')
        $ipInt = ([long]$ipOctets[0] * 16777216) + ([long]$ipOctets[1] * 65536) + ([long]$ipOctets[2] * 256) + [long]$ipOctets[3]

        foreach ($range in $Global:WhitelistedIPRanges) {
            if ($ipInt -ge $range.Start -and $ipInt -le $range.End) {
                return $true
            }
        }
    }
    return $false
}

function Test-IsPrivateIP {
    param([string]$IP)
    if ([string]::IsNullOrWhiteSpace($IP)) { return $false }
    if ($IP -match "^10\.") { return $true }
    if ($IP -match "^192\.168\.") { return $true }
    if ($IP -match "^172\.(1[6-9]|2[0-9]|3[0-1])\.") { return $true }
    return $false
}

function Test-IsDoD {
    param([string]$NetName, [string]$Descr, [string]$Owner, [string]$NsLookup)
    $DoDRegex = "(?i)\b(DoD|DoDNIC|Department of Defense|DISA|Defense Information Systems Agency|US Army|U\.?S\.? Army|US Navy|U\.?S\.? Navy|US Air Force|U\.?S\.? Air Force|USMC|Marine Corps|Pentagon|Defense Logistics Agency|National Guard)\b|(?i)(\.mil\b|usarmy|usnavy|usaf|usmc|army|navy|airforce|marines|rotc)"

    if ($NetName -match $DoDRegex) { return $true }
    if ($Descr -match $DoDRegex) { return $true }
    if ($Owner -match $DoDRegex) { return $true }
    if ($NsLookup -match $DoDRegex) { return $true }
    return $false
}

