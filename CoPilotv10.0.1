# CLM / PowerShell 5.1-SAFE ENVIRONMENT VARIABLE OVERRIDE HELPER
function Get-EnvironmentOverride {
    param(
        [string]$EnvironmentVariable,
        [string]$FallbackValue
    )

    try {
        $EnvItem = Get-Item -LiteralPath ("Env:" + $EnvironmentVariable) -ErrorAction SilentlyContinue

        if ($EnvItem -and -not [string]::IsNullOrWhiteSpace([string]$EnvItem.Value)) {
            return ([string]$EnvItem.Value).Trim()
        }
    } catch {}

    return $FallbackValue
}

