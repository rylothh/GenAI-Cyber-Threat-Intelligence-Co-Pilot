        "8443" { return "TCP (HTTPS Alternate)" }
        default { return "N/A" }
    }
}

function Unwrap-Arin {
    param($Item)
    if ($null -eq $Item) { return "" }
    if ($null -ne $Item.'$') { return [string]$Item.'$' }
    return [string]$Item
}

# HELPER: CLM-SAFE RECURSIVE VCARD HUNTING
function Get-VCardData {
    param($Object)
    $res = @{ fn = ""; street = ""; city = ""; state = ""; zip = ""; country = ""; found = $false }

    if ($Object.entities) {
        foreach ($ent in $Object.entities) {
            if ($ent.vcardArray) {
                $res.found = $true
                foreach ($elem in $ent.vcardArray[1]) {
                    if ($elem[0] -eq "fn" -and $elem[3]) { $res.fn = $elem[3] }
                    if ($elem[0] -eq "adr" -and $elem[3] -is [array]) {
                        if ($elem[3][2]) { $res.street = $elem[3][2] }
                        if ($elem[3][3]) { $res.city = $elem[3][3] }
                        if ($elem[3][4]) { $res.state = $elem[3][4] }
                        if ($elem[3][5]) { $res.zip = $elem[3][5] }
                        if ($elem[3][6]) { $res.country = $elem[3][6] }
                    }
                }
            }
            if ($ent.entities) {
                foreach ($subEnt in $ent.entities) {
                    if ($subEnt.vcardArray) {
                        $res.found = $true
                        foreach ($elem in $subEnt.vcardArray[1]) {
                            if ($elem[0] -eq "fn" -and $elem[3] -and $res.fn -eq "") { $res.fn = $elem[3] }
                            if ($elem[0] -eq "adr" -and $elem[3] -is [array]) {
                                if ($elem[3][2] -and $res.street -eq "") { $res.street = $elem[3][2] }
                                if ($elem[3][3] -and $res.city -eq "") { $res.city = $elem[3][3] }
                                if ($elem[3][4] -and $res.state -eq "") { $res.state = $elem[3][4] }
                                if ($elem[3][5] -and $res.zip -eq "") { $res.zip = $elem[3][5] }
                                if ($elem[3][6] -and $res.country -eq "") { $res.country = $elem[3][6] }
                            }
                        }
                    }
                }
            }
        }
    }
    return $res
}

# HELPER: CONVERT A VALID IPV4 RANGE TO CIDR
function Convert-IPv4RangeToCidr {
    param(
        [string]$StartIP,
        [string]$EndIP
    )

    if ($StartIP -notmatch "^(\d{1,3}\.){3}\d{1,3}$") { return "N/A" }
    if ($EndIP -notmatch "^(\d{1,3}\.){3}\d{1,3}$") { return "N/A" }

    $StartOctets = $StartIP.Split('.')
    $EndOctets = $EndIP.Split('.')

    foreach ($Octet in $StartOctets) {
        if ([int]$Octet -lt 0 -or [int]$Octet -gt 255) { return "N/A" }
    }

    foreach ($Octet in $EndOctets) {
        if ([int]$Octet -lt 0 -or [int]$Octet -gt 255) { return "N/A" }
    }

    $StartInt = ([long]$StartOctets[0] * 16777216) + ([long]$StartOctets[1] * 65536) + ([long]$StartOctets[2] * 256) + [long]$StartOctets[3]
    $EndInt = ([long]$EndOctets[0] * 16777216) + ([long]$EndOctets[1] * 65536) + ([long]$EndOctets[2] * 256) + [long]$EndOctets[3]

    if ($EndInt -lt $StartInt) { return "N/A" }

    $Count = $EndInt - $StartInt + 1
    $ExpectedCount = 1

    while ($ExpectedCount -lt $Count) {
        $ExpectedCount = $ExpectedCount * 2
    }

    if ($ExpectedCount -ne $Count) { return "N/A" }
    if (($StartInt % $Count) -ne 0) { return "N/A" }

    $PrefixLength = 32
    while ($Count -gt 1) {
        $PrefixLength--
        $Count = $Count / 2
    }

    return "$StartIP/$PrefixLength"
}

# HELPER: FOREIGN-RIR ENRICHMENT THROUGH RIPESTAT WHOIS
# Obtains the specific RIR assignment rather than an ARIN ERX parent record.
function Get-ForeignRirWhoisInfo {
    param([string]$IP)

    $Result = @{
        Found = $false
        Registry = "N/A"
        NetRange = "N/A"
        CIDR = "N/A"
        NetName = "N/A"
        Organization = "N/A"
        OrgName = "N/A"
        Descr = "N/A"
        City = "N/A"
        StateProv = "N/A"
        Country = "N/A"
        Source = "N/A"
    }

    if ([string]::IsNullOrWhiteSpace($IP) -or $IP -eq "N/A") {
        return $Result
    }

    $WhoisData = Invoke-SafeRest `
        -Uri "https://stat.ripe.net/data/whois/data.json?resource=$IP" `
        -Headers @{ "Accept" = "application/json" }

    if (-not $WhoisData -or -not $WhoisData.data -or -not $WhoisData.data.records) {
        return $Result
    }

    $Authorities = ""
    if ($WhoisData.data.authorities) {
        $Authorities = ([string]($WhoisData.data.authorities -join ",")).ToUpper()
    }

    if ($Authorities -match "RIPE") {
        $Result.Registry = "RIPE"
    } elseif ($Authorities -match "APNIC") {
        $Result.Registry = "APNIC"
    } elseif ($Authorities -match "LACNIC") {
        $Result.Registry = "LACNIC"
    } elseif ($Authorities -match "AFRINIC") {
        $Result.Registry = "AFRINIC"
    } else {
        return $Result
    }

    $NetworkRecord = $null
    $OrganizationRecord = $null

    foreach ($Record in $WhoisData.data.records) {
        $Attributes = @{}

        foreach ($Entry in $Record) {
            if ($Entry.key -and $null -ne $Entry.value) {
                $Attributes[[string]$Entry.key.ToLower()] = [string]$Entry.value
            }
        }

        if (-not $NetworkRecord -and ($Attributes.ContainsKey("inetnum") -or $Attributes.ContainsKey("inet6num"))) {
            $NetworkRecord = $Attributes
        }

        if (-not $OrganizationRecord -and ($Attributes.ContainsKey("organisation") -or $Attributes.ContainsKey("org-name"))) {
            $OrganizationRecord = $Attributes
        }
    }

    if (-not $NetworkRecord) {
        return $Result
    }

    $RangeText = "N/A"
    if ($NetworkRecord.ContainsKey("inetnum")) {
        $RangeText = $NetworkRecord["inetnum"]
    } elseif ($NetworkRecord.ContainsKey("inet6num")) {
        $RangeText = $NetworkRecord["inet6num"]
    }

    $Result.NetRange = $RangeText

    if ($RangeText -match "^(\d{1,3}(?:\.\d{1,3}){3})\s*-\s*(\d{1,3}(?:\.\d{1,3}){3})$") {
        $Result.CIDR = Convert-IPv4RangeToCidr -StartIP $Matches[1] -EndIP $Matches[2]
    } elseif ($RangeText -match "/") {
        $Result.CIDR = $RangeText
    }

    if ($NetworkRecord.ContainsKey("netname")) {
        $Result.NetName = $NetworkRecord["netname"]
    }

    if ($OrganizationRecord) {
        if ($OrganizationRecord.ContainsKey("org-name")) {
            $Result.Organization = $OrganizationRecord["org-name"]
            $Result.OrgName = $OrganizationRecord["org-name"]
            $Result.Descr = $OrganizationRecord["org-name"]
        }

        # Organization country is preferred over broad inetnum region values such as EU.
        if ($OrganizationRecord.ContainsKey("country")) {
            $Result.Country = $OrganizationRecord["country"]
        }
    }

    if ($Result.Organization -eq "N/A" -and $NetworkRecord.ContainsKey("descr")) {
        $Result.Organization = $NetworkRecord["descr"]
        $Result.OrgName = $NetworkRecord["descr"]
        $Result.Descr = $NetworkRecord["descr"]
    }

    if ($Result.Country -eq "N/A" -and $NetworkRecord.ContainsKey("country")) {
        $Result.Country = $NetworkRecord["country"]
    }

    $Result.Source = $Result.Registry
    $Result.Found = $true
    return $Result
}

# HELPER: UNIVERSAL RDAP EXTRACTOR (WITH ARIN BYPASS & HTTP API FALLBACK)
function Get-RdapInfo {
    param($IP)
    $Result = @{
        Registry = "ARIN"; NetRange = "N/A"; CIDR = "N/A"; NetName = "N/A"; NetHandle = "N/A";
        Parent = "N/A"; NetType = "N/A"; Organization = "N/A"; RegDate = "N/A"; OrgName = "N/A";
        OrgId = "N/A"; Address = "N/A"; City = "N/A"; StateProv = "N/A"; PostalCode = "N/A";
        Country = "N/A"; Route = "N/A"; OriginAS = "N/A"; MntBy = "N/A"; LastModified = "N/A"; Source = "N/A"; Descr = "N/A"
    }
    if ([string]::IsNullOrWhiteSpace($IP) -or $IP -eq "N/A") { return $Result }

    Write-Host "[!] Querying Registry Data for $IP..." -ForegroundColor Cyan

    $isForeignRir = $false

    # 1. Dual-Layer ARIN Lookup (RDAP first to identify registry, then REST for pretty layout)
    $ArinRdap = Invoke-SafeRest -Uri "https://rdap.arin.net/registry/ip/$IP" -Headers @{ "Accept" = "application/rdap+json" }
    if ($ArinRdap -and $ArinRdap.port43 -notmatch "whois.arin.net") {
        $isForeignRir = $true
    } else {
        $ArinRest = Invoke-SafeRest -Uri "https://whois.arin.net/rest/ip/$($IP).json" -Headers @{ "Accept" = "application/json" }
        $Result.Registry = "ARIN"; $Result.Source = "ARIN"

        if ($ArinRest -and $ArinRest.net) {
            $start = Unwrap-Arin $ArinRest.net.startAddress
            $end = Unwrap-Arin $ArinRest.net.endAddress
            if ($start -and $end) { $Result.NetRange = "$start - $end" }

            $netBlock = $ArinRest.net.netBlocks.netBlock
            if ($netBlock -is [array]) { $netBlock = $netBlock[0] }
            if ($netBlock) {
                $cidrLen = Unwrap-Arin $netBlock.cidrLength
                if ($cidrLen -and $start) { $Result.CIDR = "$start/$cidrLen" }
                $desc = Unwrap-Arin $netBlock.description
                if ($desc) { $Result.NetType = $desc }
            }

            $nName = Unwrap-Arin $ArinRest.net.name
            if ($nName) { $Result.NetName = $nName }
            $nHand = Unwrap-Arin $ArinRest.net.handle
            if ($nHand) { $Result.NetHandle = $nHand }

            $parent = Unwrap-Arin $ArinRest.net.parentNetRef.'@name'
            $parentHand = Unwrap-Arin $ArinRest.net.parentNetRef.'@handle'
            if ($parent -and $parentHand) { $Result.Parent = "$parent ($parentHand)" } elseif ($parentHand) { $Result.Parent = $parentHand }

            $regDate = Unwrap-Arin $ArinRest.net.registrationDate
            if ($regDate) { $Result.RegDate = ($regDate -split "T")[0] }

            $custRef = Unwrap-Arin $ArinRest.net.customerRef
            $orgRef = Unwrap-Arin $ArinRest.net.orgRef
            $refToFetch = $null; $refType = ""

            if ($custRef) { $refToFetch = $custRef; $refType = "customer" }
            elseif ($orgRef) { $refToFetch = $orgRef; $refType = "org" }

            if ($refToFetch) {
                $RefData = Invoke-SafeRest -Uri "$($refToFetch).json" -Headers @{ "Accept" = "application/json" }
                if ($RefData -and $RefData.$refType) {
                    $entity = $RefData.$refType
                    $eName = Unwrap-Arin $entity.name
                    $eHand = Unwrap-Arin $entity.handle
                    if ($eName) { $Result.OrgName = $eName; $Result.Organization = $eName; $Result.Descr = $eName }
                    if ($eHand) { $Result.OrgId = $eHand; if ($eName) { $Result.Organization = "$eName ($eHand)" } }

                    $stAddr = $entity.streetAddress.line
                    if ($stAddr) {
                        if ($stAddr -is [array]) { $Result.Address = $stAddr -join ", " } else { $Result.Address = Unwrap-Arin $stAddr }
                    }
                    $city = Unwrap-Arin $entity.city
                    if ($city) { $Result.City = $city }
                    $st = Unwrap-Arin $entity.'iso3166-2'
                    if ($st) { $Result.StateProv = $st }
                    $zip = Unwrap-Arin $entity.postalCode
                    if ($zip) { $Result.PostalCode = $zip }
                    $cty = Unwrap-Arin $entity.'iso3166-1'.code2
                    if ($cty) { $Result.Country = $cty }
                }
            }
        } elseif ($ArinRdap) {
            if ($ArinRdap.startAddress -and $ArinRdap.endAddress) { $Result.NetRange = "$($ArinRdap.startAddress) - $($ArinRdap.endAddress)" }
            if ($ArinRdap.handle) { $Result.NetHandle = $ArinRdap.handle; $Result.NetName = $ArinRdap.handle }
            if ($ArinRdap.name) { $Result.NetName = $ArinRdap.name }
            if ($ArinRdap.type) { $Result.NetType = $ArinRdap.type }

            $VCard = Get-VCardData -Object $ArinRdap
            if ($VCard.found) {
                if ($VCard.fn) { $Result.OrgName = $VCard.fn; $Result.Organization = $VCard.fn; $Result.Descr = $VCard.fn }
                if ($VCard.street) { $Result.Address = $VCard.street }
                if ($VCard.city) { $Result.City = $VCard.city }
                if ($VCard.state) { $Result.StateProv = $VCard.state }
                if ($VCard.zip) { $Result.PostalCode = $VCard.zip }
                if ($VCard.country) { $Result.Country = $VCard.country }
            }
        }
    }
    # 2. GLOBAL RDAP (RIPE / APNIC / LACNIC / AFRINIC)
    if ($isForeignRir) {
        $RdapGlobal = Invoke-SafeRest -Uri "https://rdap.org/ip/$IP" -Headers @{ "Accept" = "application/rdap+json" }
        if ($RdapGlobal) {
            if ($RdapGlobal.port43) {
                $p43 = $RdapGlobal.port43.ToLower()
                if ($p43 -match "ripe") { $Result.Registry = "RIPE"; $Result.Source = "RIPE" }
                elseif ($p43 -match "apnic") { $Result.Registry = "APNIC"; $Result.Source = "APNIC" }
                elseif ($p43 -match "afrinic") { $Result.Registry = "AFRINIC"; $Result.Source = "AFRINIC" }
                elseif ($p43 -match "lacnic") { $Result.Registry = "LACNIC"; $Result.Source = "LACNIC" }
                else { $Result.Registry = "RDAP"; $Result.Source = $RdapGlobal.port43 }
            } else { $Result.Registry = "RDAP" }

            if ($RdapGlobal.startAddress -and $RdapGlobal.endAddress) { $Result.NetRange = "$($RdapGlobal.startAddress) - $($RdapGlobal.endAddress)" }
            elseif ($RdapGlobal.handle) { $Result.NetRange = $RdapGlobal.handle }
            elseif ($RdapGlobal.inetnum) { $Result.NetRange = $RdapGlobal.inetnum }

            if ($RdapGlobal.name) { $Result.NetName = $RdapGlobal.name }
            if ($RdapGlobal.type) { $Result.NetType = $RdapGlobal.type }

            try {
                if ($RdapGlobal.notices) {
                    foreach ($n in $RdapGlobal.notices) {
                        if ($n.title -match "related to '(.+?)(AS\d+)'") {
                            $Result.Route = $Matches[1]; $Result.OriginAS = $Matches[2]
                        }
                    }
                }
            } catch {}

            try {
                if ($RdapGlobal.events) {
                    foreach ($ev in $RdapGlobal.events) {
                        if ($ev.eventAction -match 'last changed') { $Result.LastModified = $ev.eventDate; break }
                    }
                }
            } catch {}

            $VCard = Get-VCardData -Object $RdapGlobal
            if ($VCard.found) {
                if ($VCard.fn) { $Result.OrgName = $VCard.fn; $Result.Organization = $VCard.fn; $Result.Descr = $VCard.fn }
                if ($VCard.street) { $Result.Address = $VCard.street }
                if ($VCard.city) { $Result.City = $VCard.city }
                if ($VCard.state) { $Result.StateProv = $VCard.state }
                if ($VCard.zip) { $Result.PostalCode = $VCard.zip }
                if ($VCard.country) { $Result.Country = $VCard.country }
            }

            try {
                if ($RdapGlobal.remarks) {
                    foreach ($rem in $RdapGlobal.remarks) {
                        foreach ($line in $rem.description) {
                            if ($Result.Descr -eq "N/A" -and (-not ($line -match "^(route|origin|mnt-by|source|last-modified):"))) { $Result.Descr = $line.Trim() }
                            if ($line -match "^route:\s+(.+)") { $Result.Route = $Matches[1].Trim() }
                            if ($line -match "^origin:\s+(.+)") { $Result.OriginAS = $Matches[1].Trim() }
                            if ($line -match "^mnt-by:\s+(.+)") { $Result.MntBy = $Matches[1].Trim() }
                        }
                    }
                }
            } catch {}
        }
    }

    # 2B. FOREIGN-RIR AUTHORITATIVE WHOIS OVERRIDE
    # This runs even where ARIN returns an ERX parent block, such as 141.0.0.0/8.
    $ForeignRir = Get-ForeignRirWhoisInfo -IP $IP

    if ($ForeignRir.Found) {
        $Result.Registry = $ForeignRir.Registry
        $Result.NetRange = $ForeignRir.NetRange
        $Result.CIDR = $ForeignRir.CIDR
        $Result.NetName = $ForeignRir.NetName
        $Result.Organization = $ForeignRir.Organization
        $Result.OrgName = $ForeignRir.OrgName
        $Result.Descr = $ForeignRir.Descr
        $Result.City = $ForeignRir.City
        $Result.StateProv = $ForeignRir.StateProv
        $Result.Country = $ForeignRir.Country
        $Result.Source = $ForeignRir.Source
    }


    # 3. OPTIONAL PLAINTEXT HTTP IP-API FALLBACK
    # ARIN REST, ARIN RDAP, and global RDAP execute before this section.
    # Disabled by default because the free ip-api.com endpoint uses plaintext HTTP.
    if ($EnablePlaintextGeoFallback -and ($Result.Country -eq "N/A" -or $Result.Descr -eq "N/A" -or $Result.NetRange -eq "N/A")) {
        Write-Host "[!] Using optional plaintext IP geolocation fallback for $IP..." -ForegroundColor Yellow

        $GeoApi = Invoke-SafeRest -Uri "http://ip-api.com/json/$IP"
        if ($GeoApi -and $GeoApi.status -eq "success") {
            if ($Result.Country -eq "N/A" -and $GeoApi.countryCode) { $Result.Country = $GeoApi.countryCode }
            if ($Result.StateProv -eq "N/A" -and $GeoApi.region) { $Result.StateProv = $GeoApi.region }
            if ($Result.City -eq "N/A" -and $GeoApi.city) { $Result.City = $GeoApi.city }
            if ($Result.PostalCode -eq "N/A" -and $GeoApi.zip) { $Result.PostalCode = $GeoApi.zip }

            if ($Result.Descr -eq "N/A" -and $GeoApi.org) { $Result.Descr = $GeoApi.org }
            if ($Result.OrgName -eq "N/A" -and $GeoApi.org) { $Result.OrgName = $GeoApi.org }
            if ($Result.NetName -eq "N/A" -and $GeoApi.isp) { $Result.NetName = $GeoApi.isp }

            if ($Result.OriginAS -eq "N/A" -and $GeoApi.as) {
                if ($GeoApi.as -match "^(AS\d+)\s+(.+)") {
                    $Result.OriginAS = $Matches[1]
                    if ($Result.Descr -eq "N/A") { $Result.Descr = $Matches[2] }
                } else {
                    $Result.OriginAS = $GeoApi.as
                }
            }
        }
    }
    elseif (-not $EnablePlaintextGeoFallback -and ($Result.Country -eq "N/A" -or $Result.Descr -eq "N/A" -or $Result.NetRange -eq "N/A")) {
        Write-Host "[i] Plaintext IP geolocation fallback is disabled; retaining registry-derived results." -ForegroundColor DarkYellow
    }

    # Universal N/A Sanitization
    foreach ($key in @($Result.Keys)) {
        if ($Result[$key] -is [array]) { $Result[$key] = $Result[$key] -join ", " }
        $val = [string]$Result[$key]
        if ([string]::IsNullOrWhiteSpace($val)) { $Result[$key] = "N/A" }
        else { $Result[$key] = $val.Trim() }
    }

    return $Result
}

# --- GENAI ANALYSIS ---
function Invoke-AIAnalysis {
    param($ContextData, $ElasticRule)
    Write-Host "[i] Requesting AI Intelligence Analysis..." -ForegroundColor Magenta
    $Headers = @{ "Authorization" = "Bearer $GenAI_Key"; "Content-Type" = "application/json" }

    $Prompt = "Expert cyber incident handling analysis. Plain text only!!! Avoid usage of unintelligible non-English ascii-style formatting where not commanded in this prompt. Do not use emojis. Do not use HTML/CSS formatting to bold/italics/list or order, etc as it will not work in plaintext. If producing a URL, file hash, or filepath from a potentially malicious payload, obfuscate or defang the URL by placing brackets around the colons, and replace 'https' with 'hxxps' by whatever means necessary to prevent it from highlighting as an embedded URL or hyperlink, to prevent accidental clicking. DO NOT defang or obfuscate IPs. When writing in the 'CSSP Analysis' section, write only your analysis; no extra formatting such as hyphens, linebreaks, etcetera are required, and no title is required as your prompt is pre-formatted to inject into a Powershell script outside of Gemini. Be detailed yet concise. Analyze the provided telemetry based on the text context appended below, which contains pre-gathered open-source intelligence. Do not attempt to run any external lookups yourself. The alert triggered on this Elastic Rule: '$ElasticRule'. 1 paragraph summary assessing the relationship between these indicators and the rule. DO NOT SAY ANYTHING ALONG THE LINES OF 'I, Gemini Enterprise, have analyzed the network telemetry involving source IP 3.5.12.238 and target IP 65.116.218.113.' Do not acknowledge yourself in your analysis. DO NOT begin your response with titles like 'CSSP Analysis:', 'Analysis:', or 'CSSP ANALYSIS'. Start directly with the first sentence of your analysis. Do not write any suggestions or recommendations; write only the facts that have been observed with open source material." + $ContextData

    $Payload = @{ model = $GenAI_Model; messages = @(@{ role = "user"; content = $Prompt }) } | ConvertTo-Json -Depth 10
    $Response = Invoke-SafeRest -Uri $GenAI_Endpoint -Method Post -Headers $Headers -Body $Payload -ShowError $true -TimeoutSec 120
    if ($Response) { return $Response.choices[0].message.content.Trim() }
    return "AI Analysis failed to generate a response. Resend another request as this may have been a parsing issue. If this occurs multiple times and is not due to network access or admin restrictions, check that the GenAI API key in this code is unlocked or active as the key may have expired. Go to https://genai.mil/stark/user-ui/ for new API keys."
}

# --- INTERACTIVE CHAT SESSION ---
function Start-AIChat {
    param($Context, $Verdict, $ElasticRule)
    Write-Host "`n--- AI CHAT MODE ACTIVATED ---" -ForegroundColor Magenta
    Write-Host "Type 'done' to exit.`n" -ForegroundColor Gray
    $History = @(); $History += @{ role = "system"; content = "Expert cyber incident handling analysis. Rule: $ElasticRule. Context: $Context. Verdict: $Verdict. You must analyze based on the provided context only, do not attempt to run external lookups." }
    while ($true) {
        $In = Clean-Input (Read-Host -Prompt "[YOU]")
        if ($In -eq 'done' -or $In -eq 'exit') { break }
        $History += @{ role = "user"; content = $In }
        $Payload = @{ model = $GenAI_Model; messages = $History } | ConvertTo-Json -Depth 10
        $Res = Invoke-SafeRest -Uri $GenAI_Endpoint -Method Post -Headers @{ "Authorization" = "Bearer $GenAI_Key"; "Content-Type" = "application/json" } -Body $Payload -ShowError $true -TimeoutSec 120
        if ($Res) { $Ans = $Res.choices.message.content.Trim(); Write-Host "[AI] $Ans`n" -ForegroundColor Cyan; $History += @{ role = "assistant"; content = $Ans } }
    }
}

# --- REGISTRY LAYOUT GENERATOR ---
function Get-RegistryLayout {
    param($ArinData, $IsMilDest)

    $Prefix = if ($IsMilDest) { "Military" } else { "Source" }
    $Registry = $ArinData.Registry

    if ([string]::IsNullOrWhiteSpace($Registry) -or $Registry -eq "N/A") {
        $Registry = "RIR"
    }

    $LocationParts = @()

if ($ArinData.City -and $ArinData.City -ne "N/A") {
    $LocationParts += $ArinData.City
	}

if ($ArinData.StateProv -and $ArinData.StateProv -ne "N/A") {
    $LocationParts += $ArinData.StateProv
	}

if ($ArinData.Country -and $ArinData.Country -ne "N/A") {
    $LocationParts += $ArinData.Country
	}

if ($LocationParts.Count -gt 0) {
    $Location = $LocationParts -join ", "
	} else {
    $Location = "N/A"
	}

    $B = "$Prefix $Registry`n"
    $B += "NetRange:       $($ArinData.NetRange)`n"
    $B += "CIDR:           $($ArinData.CIDR)`n"
    $B += "NetworkName:    $($ArinData.NetName)`n"
    $B += "Organization:   $($ArinData.Organization)`n"
    $B += "Location:       $Location`n"

    return $B
}
# --- TICKET GENERATOR ---
function Write-Ticket {
    param(
        $Type, $Indicator, $SrcArin, $VT, $Abuse, $ISP, $Link, $BdeData, $AI = "",
        $SrcPort = "N/A", $MilIP = "N/A", $MilPort = "N/A", $Protocol = "N/A", $SrcNsResult = "N/A", $MilNsResult = "N/A", $MilArin, $MilLink = "N/A", $IsPrivateIP = $false,
        $Sensor = "N/A", $EventTime = "N/A", $PayloadData = "N/A", $IsDoD = $false, $ElasticRule = "None Provided", $IsWhitelisted = $false, $AbuseCountry = "N/A", $KibanaAlertRuleName = "N/A"
    )

    if ($SrcArin.Country -eq "N/A" -and $AbuseCountry -ne "N/A") { $SrcArin.Country = $AbuseCountry }

    if ($IsWhitelisted) {
        $DomFor = "Authorized/Whitelisted"
    } elseif ($IsDoD) {
        $DomFor = "Domestic (DoD / Military)"
    } elseif ($IsPrivateIP) {
        $DomFor = "Internal/Private (RFC 1918)"
    } elseif ($SrcArin.Country -eq "US") {
        $DomFor = "Domestic"
    } elseif ($SrcArin.Country -ne "N/A") {
        $DomFor = "Foreign"
    } else {
        $DomFor = "N/A"
    }

    $MilLink = "N/A"; if ($MilIP -ne "N/A" -and $MilIP -ne "") { $MilLink = "https://www.whois.com/whois/$MilIP" }

    $T =  "AG / $ElasticRule`n`n"
    $T += "AFFECTED LOCATION: $($BdeData.Location)`n"
    $T += "- BDE: $($BdeData.BDE)`n- MACOM: $($BdeData.MACOM)`n- COCOM: NORTHCOM`n- EVENT TIME: $EventTime`n- SENSOR: $Sensor`n- PROTOCOL: $Protocol`n"
    $T += "***********************************`n"
    $T += "KIBANA EVENT GRID HITS: 1`n"
    $T += "***********************************`n"
    $T += "ADDITIONAL KIBANA DATA`n"
    $T += "- Event Action: Attack Blocked`n"
    $T += "- Direction: Inbound`n"
    $T += "- Network Application: HTTPS`n"
    $T += "- Kibana Alert Rulename: $KibanaAlertRuleName`n"
    $T += "***********************************`n"
    $T += "PAYLOAD: $PayloadData`n"
    $T += "***********************************`n"
    $T += "Source: $DomFor`n`n"
    if ($Type -eq "IP") {
    $T += "- IP: $Indicator`n- Port: $SrcPort`n- NSLOOKUP: $SrcNsResult`n`n"
	} else {
    $T += "- IP: $Indicator ($Type)`n- Port: $SrcPort`n- NSLOOKUP: $SrcNsResult`n`n"
	}

    $T += Get-RegistryLayout -ArinData $SrcArin -IsMilDest $false
    $T += "***********************************`n"
    $T += "Military Destination: Domestic`n`n"
    $T += "- IP: $MilIP`n- Port: $MilPort`n- NSLOOKUP: $MilNsResult`n`n"

    $T += Get-RegistryLayout -ArinData $MilArin -IsMilDest $true
    if ($Type -ne "IP") {
        $T += "`n***********************************`n"
        $T += "- MDE:`n"
    }

    $T += "***********************************`n"

    if ($IsWhitelisted) {
        $T += "- CSSP ANALYSIS:`n`n$AI`n`n[WARNING: Source Indicator is explicitly WHITELISTED. IP blocking is NOT recommended.]`n"
    } elseif ($Type -eq "IP" -and $IsDoD) {
        $T += "- CSSP ANALYSIS:`n`n$AI`n`n[WARNING: Source IP belongs to the Department of Defense (DoD). IP blocking is NOT recommended without explicit authorization.]`n"
    } elseif ($Type -eq "IP" -and $IsPrivateIP) {
        $T += "- CSSP ANALYSIS:`n`n$AI`n`n[WARNING: Source IP is an internal/private address. External IP blocking is not applicable.]`n"
    } else {
        $T += "- CSSP ANALYSIS:`n`n"
        $T += "$AI`n"
        $T += "`n- THREAT INTEL:`n"
        $T += "VirusTotal: $VT`nAbuseIPDB Score: $Abuse`nAbuseIPDB ISP:  $ISP`n"
        $T += "`nDespite the action being blocked by an IPS, there are currently no IP-Blocks submitted at the network / IP level. CSSP is submitting a 30-day IP-Block request as an additional countermeasure.`n"
    }

    $T += "`n1. What was attempted? $ElasticRule`n"
    $BlockingFactor = if ($Sensor -ne "N/A" -and $Sensor -ne "") { "IPS" } else { "[unanswered]" }
    $T += "2. What was the blocking factor? $BlockingFactor`n"

    if ($IsWhitelisted -or ($Type -eq "IP" -and ($IsDoD -or $IsPrivateIP))) {
        $T += "3. Were additional mitigation factors implemented after attempt? No -- Source is Protected/Whitelisted`n"
    } else {
        $T += "3. Were additional mitigation factors implemented after attempt? Yes -- 30-day IP block`n"
    }

    $T | Set-Clipboard

    $T_Lines = $T -split "`n"
    $inPurpleSection = $false

    foreach ($Line in $T_Lines) {
        if ($Line -match "^1\. What was attempted\?") { $inPurpleSection = $true }

        $lineColor = if ($inPurpleSection) { "Magenta" } else { "Green" }

        if ($Line -match "N/A|\[unanswered\]") {
            $Parts = [regex]::Split($Line, "(N/A|\[unanswered\])")
            foreach ($p in $Parts) {
                if ($p -eq "N/A" -or $p -eq "[unanswered]") {
                    Write-Host $p -NoNewline -ForegroundColor Red
                } elseif ($p -ne "") {
                    Write-Host $p -NoNewline -ForegroundColor $lineColor
                }
            }
            Write-Host ""
        } else {
            Write-Host $Line -ForegroundColor $lineColor
        }
    }
    Write-Host "`n[SUCCESS] Exact Layout Ticket copied to clipboard." -ForegroundColor Cyan

    if ($Link -ne "N/A" -or $MilLink -ne "N/A") {
        Write-Host "`n--- QUICK LINKS ---" -ForegroundColor DarkYellow
        if ($Link -ne "N/A") { Write-Host "Source WHOIS:      $Link" -ForegroundColor Yellow }
        if ($MilLink -ne "N/A") { Write-Host "Destination WHOIS: $MilLink" -ForegroundColor Yellow }
    }
}

# --- MAIN LOOP ---
while ($true) {
    Write-Host "`n===========================================================================" -ForegroundColor Red
    Write-Host "SecOps Cyber Threat Intelligence Co-Pilot 'Atlas-Jupiter' 10.0.1 CRJ // JRZ" -ForegroundColor Blue
    Write-Host "===========================================================================" -ForegroundColor Red
    $In = Clean-Input (Read-Host -Prompt "`nEnter Indicator (Source IP, URL, Hash), 'ED' for Endpoint JSON, or 'Exit'")
    if ($In -eq 'Exit' -or $In -eq 'exit') { break }

    # --- ENDPOINT DETECTION (ED) / RFI MODE ---
    if ($In -eq 'ED' -or $In -eq 'ed') {
        Write-Host "`n[!] Endpoint Detection (ED) / RFI Mode Activated." -ForegroundColor Cyan
        Write-Host "[i] Reading JSON from Windows Clipboard..." -ForegroundColor Gray

        $ClipData = Get-Clipboard -Raw -ErrorAction SilentlyContinue
        if ([string]::IsNullOrWhiteSpace($ClipData)) {
            Write-Host "[!] Clipboard is empty or contains invalid data. Please copy the Kibana JSON and try again." -ForegroundColor Red
            continue
        }

        $ClipData = Defang-Payload -Text $ClipData
        if ($ClipData.Length -gt 150000) { $ClipData = $ClipData.Substring(0, 150000) + "...[TRUNCATED]" }

        $step = 1
        while ($step -le 2) {
            switch ($step) {
                1 {
                    $InputLocation = Clean-Input (Read-Host -Prompt "1/2: Enter Affected Location/Base (e.g. 'Liberty') (or 'b' to go back)")
                    if ($InputLocation -eq 'b') { Write-Host "Canceled."; break }
                    $step++
                }
                2 {
                    $MilIP = Clean-Input (Read-Host -Prompt "2/2: Enter Host/MIL IP for ARIN Lookup (or '127.0.0.1') (or 'b' to go back)")
                    if ($MilIP -eq 'b') { $step--; continue }
                    $step++
                }
            }
        }
        if ($InputLocation -eq 'b') { continue }

        if ([string]::IsNullOrWhiteSpace($MilIP)) { $MilIP = "N/A" }
        if ([string]::IsNullOrWhiteSpace($InputLocation)) { $InputLocation = "N/A" }

        $BdeData = Get-BdeInfo -SearchLocation $InputLocation
        $MilLink = "N/A"
        $MilArin = @{ Registry = "ARIN"; NetRange = "N/A"; CIDR = "N/A"; NetName = "N/A"; NetHandle = "N/A"; Parent = "N/A"; NetType = "N/A"; Organization = "N/A"; RegDate = "N/A"; OrgName = "N/A"; OrgId = "N/A"; Address = "N/A"; City = "N/A"; StateProv = "N/A"; PostalCode = "N/A"; Country = "N/A"; Route = "N/A"; OriginAS = "N/A"; MntBy = "N/A"; LastModified = "N/A"; Source = "N/A"; Descr = "N/A" }

        if ($MilIP -eq "127.0.0.1" -or $MilIP -eq "::1" -or $MilIP -match "^localhost$") {
            $MilArin.NetRange = "127.0.0.0/8"
            $MilArin.NetName = "Loopback"
            $MilArin.Descr = "Localhost Loopback Address"
        } elseif ($MilIP -match "^(\d{1,3}\.){3}\d{1,3}$") {
            $MilArin = Get-RdapInfo -IP $MilIP
            $MilLink = "https://www.whois.com/whois/$MilIP"
        }

        $ArinText = Get-RegistryLayout -ArinData $MilArin -IsMilDest $true

        $EDPrompt = @"
You are an expert cyber incident handler. I am providing a Kibana Endpoint JSON log and some pre-gathered OSINT data.
Generate the incident ticket EXACTLY in the format below. Do not add markdown code blocks (like ```) around the output.
Extract the bracketed fields from the JSON. Search deeply inside the '_source', 'fields', and 'Events' arrays to find the data. If a field is missing in the JSON, write N/A.
IMPORTANT: For fields already populated below (such as LOCATION, BDE, and the ARIN block), leave them exactly as-is. Do NOT overwrite them with N/A.

ED / [kibana.alert.rule.name]

- AFFECTED LOCATION: $($BdeData.Location)
- BDE: $($BdeData.BDE)
- MACOM: $($BdeData.MACOM)
- COCOM: NORTHCOM
- EVENT TIME: [@timestamp]
***********************************
- HOSTNAME: [host.hostname or host.name]
- HOST IPs: [all host.ip values, comma separated]
- HOST OS: [host.os.full or host.os.name]
- USER: [user.id or user.name]

$($ArinText.TrimEnd())
***********************************
Elastic SIEM Detection Fields:
PROCESS.PARENT.EXECUTABLE: [process.parent.executable]

Kibana.alert.reason: "[kibana.alert.reason]"

Events Process Executable:
"[Events.process.executable or process.executable]"

Events Process Command Line:
"[Events.process.command_line or process.command_line]"
***********************************

- CSSP ANALYSIS:
[Write a 1-2 paragraph analysis determining what is occurring, analyzing the command line and parent executable, and evaluating the potential for this being a false-positive.]

CSSP will RFI site to confirm if activity is authorized.

--- END OF FORMAT ---

JSON DATA:
$ClipData
"@
        $AnalyzeLoop = $true
        do {
            Write-Host "[i] Requesting Endpoint AI Analysis..." -ForegroundColor Magenta
            $Payload = @{ model = $GenAI_Model; messages = @(@{ role = "user"; content = $EDPrompt }) } | ConvertTo-Json -Depth 10
            $Response = Invoke-SafeRest -Uri $GenAI_Endpoint -Method Post -Headers @{ "Authorization" = "Bearer $GenAI_Key"; "Content-Type" = "application/json" } -Body $Payload -ShowError $true -TimeoutSec 120

            if ($Response) {
                $TicketText = $Response.choices[0].message.content.Trim()
                $TicketText = $TicketText -replace "^```(text)?\s*", "" -replace "```$", ""

                $TicketText | Set-Clipboard

                $T_Lines = $TicketText -split "`n"
                foreach ($Line in $T_Lines) {
                    if ($Line -match "N/A") {
                        $Parts = [regex]::Split($Line, "(N/A)")
                        foreach ($p in $Parts) {
                            if ($p -eq "N/A") { Write-Host $p -NoNewline -ForegroundColor Red }
                            elseif ($p -ne "") { Write-Host $p -NoNewline -ForegroundColor Green }
                        }
                        Write-Host ""
                    } else {
                        Write-Host $Line -ForegroundColor Green
                    }
                }
                Write-Host "`n[SUCCESS] ED Ticket copied to clipboard." -ForegroundColor Cyan
                if ($MilLink -ne "N/A") { Write-Host "Destination WHOIS: $MilLink" -ForegroundColor Yellow }
            } else {
                Write-Host "[!] AI Analysis failed." -ForegroundColor Red
            }

            Write-Host "`n[?] Post-Ticket Actions:" -ForegroundColor Yellow
            Write-Host "[r] Re-run AI Analysis"
            Write-Host "[Enter] Analyze a new indicator"
            $PostAction = Read-Host -Prompt "Action"
            if ($PostAction -eq 'r') { Write-Host "`n[!] Re-running..." -ForegroundColor Cyan }
            else { $AnalyzeLoop = $false }
        } while ($AnalyzeLoop -eq $true)

        continue
    }
    # --- END OF ED MODE ---

    elseif ($In -match "^(\d{1,3}\.){3}\d{1,3}$") {
        # IP ROUTE
        Write-Host "[!] Analyzing IP: $In..." -ForegroundColor Cyan

        $IsPrivate = Test-IsPrivateIP -IP $In
        if ($IsPrivate) {
            Write-Host "`n************************************************************" -ForegroundColor Red -BackgroundColor Black
            Write-Host " [CRITICAL WARNING] INTERNAL/PRIVATE IP DETECTED (RFC 1918) " -ForegroundColor White -BackgroundColor Red
            Write-Host " DO NOT BLOCK THIS IP. PLEASE DOUBLE-CHECK YOUR INDICATOR!  " -ForegroundColor White -BackgroundColor Red
            Write-Host "************************************************************`n" -ForegroundColor Red -BackgroundColor Black
        }

        $IsWhitelisted = Test-IsWhitelisted -Indicator $In
        if ($IsWhitelisted) {
            Write-Host "`n************************************************************" -ForegroundColor Red -BackgroundColor Black
            Write-Host " [CRITICAL WARNING] WHITELISTED/AUTHORIZED INDICATOR DETECTED " -ForegroundColor White -BackgroundColor Red
            Write-Host " DO NOT BLOCK THIS IP. PLEASE DOUBLE-CHECK YOUR INDICATOR!  " -ForegroundColor White -BackgroundColor Red
            Write-Host "************************************************************`n" -ForegroundColor Red -BackgroundColor Black
        }

        # 1. State Machine for Inputs
        $step = 1
        while ($step -le 9) {
            switch ($step) {
                1 {
                    $SrcPort = Clean-Input (Read-Host -Prompt "1/9: Enter Source Port (or 'b' to go back, Enter to skip)")
                    if ($SrcPort -eq 'b') { Write-Host "[!] Already at first step." -ForegroundColor Yellow; continue }
                    $step++
                }
                2 {
                    $MilIP = Clean-Input (Read-Host -Prompt "2/9: Enter MIL Dest IP (or 'b' to go back, Enter to skip)")
                    if ($MilIP -eq 'b') { $step--; continue }
                    $step++
                }
                3 {
                    $MilPort = Clean-Input (Read-Host -Prompt "3/9: Enter MIL Dest Port (or 'b' to go back, Enter to skip)")
                    if ($MilPort -eq 'b') { $step--; continue }
                    $step++
                }
                4 {
                    $ElasticRule = Clean-Input (Read-Host -Prompt "4/9: Enter Elastic observer.rule.name (or 'b' to go back, Enter to skip)")
                    if ($ElasticRule -eq 'b') { $step--; continue }
                    $step++
                }
                5 {
                    $InputLocation = Clean-Input (Read-Host -Prompt "5/9: Enter Affected Location/Base (e.g. 'Liberty') (or 'b' to go back)")
                    if ($InputLocation -eq 'b') { $step--; continue }
                    $step++
                }
                6 {
                    $Sensor = Clean-Input (Read-Host -Prompt "6/9: Enter Elastic observer.name / SENSOR (or 'b' to go back, Enter to skip)")
                    if ($Sensor -eq 'b') { $step--; continue }
                    $step++
                }
                7 {
                    $EventTime = Clean-Input (Read-Host -Prompt "7/9: Enter Elastic @attack_time / EVENT TIME (or 'b' to go back, Enter to skip)")
                    if ($EventTime -eq 'b') { $step--; continue }
                    $step++
                }
                8 {
                    $PayloadData = Clean-Input (Read-Host -Prompt "8/9: Enter Elastic http.request.body.content / PAYLOAD (or 'b' to go back, Enter to skip)")
                    if ($PayloadData -eq 'b') { $step--; continue }
                    $step++
                }
                9 {
                    $KibanaAlertRuleName = Clean-Input (Read-Host -Prompt "9/9 Enter Elastic kibana.alert.rule.name (or 'b' to go back, Enter to skip)")
                    if ($KibanaAlertRuleName -eq 'b') { $step--; continue}
                    $step++
                }
            }
        }

        # Normalize gathered variables
        if ([string]::IsNullOrWhiteSpace($SrcPort)) { $SrcPort = "N/A" }
        if ([string]::IsNullOrWhiteSpace($MilPort)) { $MilPort = "N/A" }
        if ([string]::IsNullOrWhiteSpace($ElasticRule)) { $ElasticRule = "None Provided" }
        if ([string]::IsNullOrWhiteSpace($Sensor)) { $Sensor = "N/A" }
        if ([string]::IsNullOrWhiteSpace($EventTime)) { $EventTime = "N/A" }
        if ([string]::IsNullOrWhiteSpace($PayloadData)) { $PayloadData = "N/A" }
        if ([string]::IsNullOrWhiteSpace($KibanaAlertRuleName)) { $KibanaAlertRuleName = "N/A" }

        # Infer Protocol
        $InferredProtocol = Get-ProtocolFromPort -Port $MilPort

        # Pull NSLookup Early for Source DoD Verification
        $SrcNsResult = Get-NsLookup -Target $In

        # 2. Open Source Intelligence Lookups
        $AbRes = Invoke-SafeRest -Uri "https://api.abuseipdb.com/api/v2/check?ipAddress=$In&maxAgeInDays=90" -Headers @{ "Key" = $Abuse_Key; "Accept" = "application/json" }
        $Ab = "N/A"; $ISP = "N/A"; $AbCty = "N/A"
        if ($AbRes) { $Ab = "$($AbRes.data.abuseConfidenceScore)%"; $ISP = $AbRes.data.isp; $AbCty = $AbRes.data.countryCode }

        $Vt = Invoke-SafeRest -Uri "https://www.virustotal.com/api/v3/ip_addresses/$In" -Headers @{ "x-apikey" = $VT_Key }
        $VTRes = "API Error"; $Owner = "N/A"
        if ($Vt) { $VTRes = "$($Vt.data.attributes.last_analysis_stats.malicious) Detections"; $Owner = $Vt.data.attributes.as_owner }

        # 3. Pull BDE/RDAP data
        $BdeData = Get-BdeInfo -SearchLocation $InputLocation
        $SrcArin = Get-RdapInfo -IP $In

        # Check for DoD Status
        $IsDoDStatus = Test-IsDoD -NetName $SrcArin.NetName -Descr $SrcArin.Descr -Owner $Owner -NsLookup $SrcNsResult
        if ($IsDoDStatus) {
            Write-Host "`n************************************************************" -ForegroundColor Red -BackgroundColor Black
            Write-Host " [CRITICAL WARNING] DoD / MILITARY SOURCE IP DETECTED       " -ForegroundColor White -BackgroundColor Red
            Write-Host " DO NOT BLOCK THIS IP WITHOUT EXPLICIT AUTHORIZATION!       " -ForegroundColor White -BackgroundColor Red
            Write-Host "************************************************************`n" -ForegroundColor Red -BackgroundColor Black
        }

        $MilNsResult = "N/A"; $MilLink = "N/A"
        $MilArin = @{ Registry = "ARIN"; NetRange = "N/A"; CIDR = "N/A"; NetName = "N/A"; NetHandle = "N/A"; Parent = "N/A"; NetType = "N/A"; Organization = "N/A"; RegDate = "N/A"; OrgName = "N/A"; OrgId = "N/A"; Address = "N/A"; City = "N/A"; StateProv = "N/A"; PostalCode = "N/A"; Country = "N/A"; Route = "N/A"; OriginAS = "N/A"; MntBy = "N/A"; LastModified = "N/A"; Source = "N/A"; Descr = "N/A" }
        if ($MilIP -match "^(\d{1,3}\.){3}\d{1,3}$") {
            $MilNsResult = Get-NsLookup -Target $MilIP
            $MilArin = Get-RdapInfo -IP $MilIP
            $MilLink = "https://www.whois.com/whois/$MilIP"
        }

        $Net = $ISP; if ($Owner -ne "N/A") { $Net = $Owner }

        # WAF Bypass Payload Defanging
        $DefangedPayload = Defang-Payload -Text $PayloadData
        $Ctx = "IP:$In, Net:$Net, Abuse:$Ab, VT:$VTRes, Payload:$DefangedPayload"
        if ($MilIP -ne "") { $Ctx += ", TargetIP:$MilIP" }

        # 4. AI Generation & Re-Run Loop
        $AnalyzeLoop = $true
        do {
            $AI = Invoke-AIAnalysis -ContextData $Ctx -ElasticRule $ElasticRule

            Write-Ticket -Type "IP" -Indicator $In -SrcArin $SrcArin `
                         -VT $VTRes -Abuse $Ab -ISP $ISP -Link "https://www.whois.com/whois/$In" -AI $AI `
                         -SrcPort $SrcPort -MilIP $MilIP -MilPort $MilPort -Protocol $InferredProtocol -SrcNsResult $SrcNsResult -MilNsResult $MilNsResult -MilArin $MilArin `
                         -MilLink $MilLink -BdeData $BdeData -IsPrivateIP $IsPrivate -IsDoD $IsDoDStatus -IsWhitelisted $IsWhitelisted `
                         -Sensor $Sensor -EventTime $EventTime -PayloadData $PayloadData -ElasticRule $ElasticRule -AbuseCountry $AbCty -KibanaAlertRuleName $KibanaAlertRuleName

            Write-Host "`n[?] Post-Ticket Actions:" -ForegroundColor Yellow
            Write-Host "[r] Re-run AI Analysis (e.g., if API key was locked)"
            Write-Host "[c] Start Interactive AI Chat"
            Write-Host "[Enter] Analyze a new indicator"
            $PostAction = Read-Host -Prompt "Action"

            if ($PostAction -eq 'r') {
                Write-Host "`n[!] Re-running analysis with existing data..." -ForegroundColor Cyan
            } elseif ($PostAction -eq 'c') {
                Start-AIChat -Context $Ctx -Verdict $AI -ElasticRule $ElasticRule
                $AnalyzeLoop = $false
            } else {
                $AnalyzeLoop = $false
            }
        } while ($AnalyzeLoop -eq $true)
    }
    elseif ($In -like "*.*" -and $In -notmatch "^([a-fA-F0-9]{64}|[a-fA-F0-9]{32})$") {
        # URL ROUTE
        $Domain = $In.Replace("https://","").Replace("http://","").Split("/")[0]
        Write-Host "[!] Analyzing URL/Domain: $In..." -ForegroundColor Cyan

        $IsWhitelisted = Test-IsWhitelisted -Indicator $Domain
        if ($IsWhitelisted) {
            Write-Host "`n************************************************************" -ForegroundColor Red -BackgroundColor Black
            Write-Host " [CRITICAL WARNING] WHITELISTED/AUTHORIZED INDICATOR DETECTED " -ForegroundColor White -BackgroundColor Red
            Write-Host " DO NOT BLOCK THIS INDICATOR. PLEASE DOUBLE-CHECK YOUR DATA!" -ForegroundColor White -BackgroundColor Red
            Write-Host "************************************************************`n" -ForegroundColor Red -BackgroundColor Black
        }

        $BdeDataBlank = @{ Location = "N/A"; BDE = "N/A"; MACOM = "N/A" }
        $ElasticRule = "None Provided"
        $SrcNsResult = Get-NsLookup -Target $Domain

        # v10.0.1: Submit privately by default. If private submission fails,
        # Invoke-UrlScanSubmission retries once with public visibility.
        $UrlScanSubmission = Invoke-UrlScanSubmission -Url $In
        $UsReq = $UrlScanSubmission.Response
        $UsVal = "Wait for Report"

        if ($UsReq) {
            if ($UrlScanSubmission.UsedPublicFallback) {
                Write-Host "[!] URL submitted to urlscan with PUBLIC visibility after private submission was unavailable." -ForegroundColor Yellow
            } else {
                Write-Host "[i] URL submitted to urlscan with $($UrlScanSubmission.Visibility) visibility." -ForegroundColor DarkCyan
            }

            Start-Sleep -Seconds 20
            $UsRes = Invoke-SafeRest -Uri "https://urlscan.io/api/v1/result/$($UsReq.uuid)/"

            if ($UsRes) {
                $UsVal = "Clean"
                if ($UsRes.verdicts.overall.malicious) {
                    $UsVal = "Malicious"
                }
            }
        }

        $Vt = Invoke-SafeRest -Uri "https://www.virustotal.com/api/v3/urls" -Method Post -Headers @{ "x-apikey" = $VT_Key } -Body (@{ url = $In } | ConvertTo-Json)
        $VTRes = "API Error"
        if ($Vt) {
            Start-Sleep -Seconds 15
            $VtR = Invoke-SafeRest -Uri "https://www.virustotal.com/api/v3/urls/$($Vt.data.id.Split('-')[1])" -Headers @{ "x-apikey" = $VT_Key }
            if ($VtR) {
                $VTRes = "$($VtR.data.attributes.last_analysis_stats.malicious) Detections"
            }
        }

        $Ctx = "URL:$In, Domain:$Domain, URLScan:$UsVal, VT:$VTRes"

        $AnalyzeLoop = $true
        do {
            $AI = Invoke-AIAnalysis -ContextData $Ctx -ElasticRule $ElasticRule
            $BlankArin = @{ Registry = "ARIN"; NetRange = "N/A"; CIDR = "N/A"; NetName = "N/A"; NetHandle = "N/A"; Parent = "N/A"; NetType = "N/A"; Organization = "N/A"; RegDate = "N/A"; OrgName = "N/A"; OrgId = "N/A"; Address = "N/A"; City = "N/A"; StateProv = "N/A"; PostalCode = "N/A"; Country = "N/A"; Route = "N/A"; OriginAS = "N/A"; MntBy = "N/A"; LastModified = "N/A"; Source = "N/A"; Descr = "N/A" }

            Write-Ticket -Type "URL" -Indicator $In -SrcArin $BlankArin -VT $VTRes -Abuse $UsVal -ISP "URLScan" -Link "https://www.whois.com/whois/$Domain" -AI $AI -BdeData $BdeDataBlank -Protocol "N/A" -SrcNsResult $SrcNsResult -ElasticRule $ElasticRule -IsWhitelisted $IsWhitelisted -MilArin $BlankArin

            Write-Host "`n[?] Post-Ticket Actions:" -ForegroundColor Yellow
            Write-Host "[r] Re-run AI Analysis"
            Write-Host "[c] Start Interactive AI Chat"
            Write-Host "[Enter] Analyze a new indicator"
            $PostAction = Read-Host -Prompt "Action"

            if ($PostAction -eq 'r') {
                Write-Host "`n[!] Re-running..." -ForegroundColor Cyan
            }
            elseif ($PostAction -eq 'c') {
                Start-AIChat -Context $Ctx -Verdict $AI -ElasticRule $ElasticRule
                $AnalyzeLoop = $false
            }
            else {
                $AnalyzeLoop = $false
            }
        } while ($AnalyzeLoop -eq $true)
    }
    elseif ($In -match "^([a-fA-F0-9]{64}|[a-fA-F0-9]{32})$") {
        # HASH ROUTE
        Write-Host "[!] Analyzing Hash: $In..." -ForegroundColor Cyan

        $BdeDataBlank = @{ Location = "N/A"; BDE = "N/A"; MACOM = "N/A" }
        $ElasticRule = "None Provided"
        $SrcNsResult = "N/A (Indicator is a Hash)"

        $VtH = Invoke-SafeRest -Uri "https://www.virustotal.com/api/v3/files/$In" -Headers @{ "x-apikey" = $VT_Key }
        $VTHash = "Not Found"
        if ($VtH) {
            $VTHash = "$($VtH.data.attributes.last_analysis_stats.malicious) Detections"
        }

        $Ctx = "Hash:$In, VT:$VTHash"

        $AnalyzeLoop = $true
        do {
            $AI = Invoke-AIAnalysis -ContextData $Ctx -ElasticRule $ElasticRule
            $BlankArin = @{ Registry = "ARIN"; NetRange = "N/A"; CIDR = "N/A"; NetName = "N/A"; NetHandle = "N/A"; Parent = "N/A"; NetType = "N/A"; Organization = "N/A"; RegDate = "N/A"; OrgName = "N/A"; OrgId = "N/A"; Address = "N/A"; City = "N/A"; StateProv = "N/A"; PostalCode = "N/A"; Country = "N/A"; Route = "N/A"; OriginAS = "N/A"; MntBy = "N/A"; LastModified = "N/A"; Source = "N/A"; Descr = "N/A" }

            Write-Ticket -Type "Hash" -Indicator $In -SrcArin $BlankArin -VT $VTHash -Abuse "N/A" -ISP "N/A" -Link "N/A" -AI $AI -BdeData $BdeDataBlank -Protocol "N/A" -SrcNsResult $SrcNsResult -ElasticRule $ElasticRule -MilArin $BlankArin

            Write-Host "`n[?] Post-Ticket Actions:" -ForegroundColor Yellow
            Write-Host "[r] Re-run AI Analysis"
            Write-Host "[c] Start Interactive AI Chat"
            Write-Host "[Enter] Analyze a new indicator"
            $PostAction = Read-Host -Prompt "Action"

            if ($PostAction -eq 'r') {
                Write-Host "`n[!] Re-running..." -ForegroundColor Cyan
            }
            elseif ($PostAction -eq 'c') {
                Start-AIChat -Context $Ctx -Verdict $AI -ElasticRule $ElasticRule
                $AnalyzeLoop = $false
            }
            else {
                $AnalyzeLoop = $false
            }
        } while ($AnalyzeLoop -eq $true)
    }
    else {
        Write-Host "[ERROR] Unrecognized indicator format." -ForegroundColor Red
    }
}
